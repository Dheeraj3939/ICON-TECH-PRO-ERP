# ==============================================================================
# ICON TECH PRO ERP - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` and configure with your live Supabase project.
#
# IMPORTANT SECURITY RULES:
# - NEVER commit `.env.local` to Git.
# - NEVER prefix `SUPABASE_SECRET_KEY` (or `SUPABASE_SERVICE_ROLE_KEY`) with `NEXT_PUBLIC_`.
# - NEVER expose the Secret key to client-side code or browser bundles.
# ==============================================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xogynsnfzsvimwtvhpx.supabase.co

# Client-Side Key (Browser Safe - Supports either variable name)
# Uses Supabase's new Publishable Key (sb_publishable_...) or legacy Anon Key (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Alternatively:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_key_here

# Server-Side Secret Key (SUPER-ADMIN - SERVER ONLY - NEVER BUNDLE TO BROWSER)
# Uses Supabase's new Secret Key (sb_secret_...) or legacy Service Role Key (eyJ...)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Alternatively:
# SUPABASE_SERVICE_ROLE_KEY=your_key_here

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Google Cloud OAuth 2.0 - Gmail Integration (SERVER ONLY - NEVER PREFIX NEXT_PUBLIC_)
# Scope: https://www.googleapis.com/auth/gmail.send
# Target Account: icontechpro@gmail.com
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SENDER_EMAIL=icontechpro@gmail.com

