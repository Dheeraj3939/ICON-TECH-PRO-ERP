			<script>
document.addEventListener('DOMContentLoaded', function () {

    const popup = document.querySelector('#pum-2517');
    if (!popup || popup.dataset.itpMinimizeReady === '1') return;

    const container = popup.querySelector('.pum-container');
    const closeButton = popup.querySelector('.pum-close');

    if (!container || !closeButton) return;

    popup.dataset.itpMinimizeReady = '1';

    // Create a shared control group.
    const controls = document.createElement('div');
    controls.className = 'itp-popup-controls';

    controls.style.cssText = `
        position: absolute;
        top: 10px;
        right: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        z-index: 1000001;
    `;

    // Move the existing close button into the shared group.
    closeButton.style.cssText = `
        position: static !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 32px !important;
        height: 32px !important;
        min-width: 32px !important;
        padding: 0 !important;
        margin: 0 !important;
        border: 0 !important;
        border-radius: 50% !important;
        background: #315f7e !important;
        color: #ffffff !important;
        font-size: 20px !important;
        line-height: 1 !important;
        box-shadow: none !important;
        cursor: pointer !important;
    `;

    // Create the minimize button.
    const minimizeButton = document.createElement('button');
    minimizeButton.type = 'button';
    minimizeButton.className = 'itp-popup-minimize';
    minimizeButton.textContent = '−';
    minimizeButton.setAttribute('aria-label', 'Minimize enquiry popup');

    minimizeButton.style.cssText = `
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 32px !important;
        height: 32px !important;
        min-width: 32px !important;
        padding: 0 !important;
        margin: 0 !important;
        border: 0 !important;
        border-radius: 50% !important;
        background: #315f7e !important;
        color: #ffffff !important;
        font-size: 22px !important;
        line-height: 1 !important;
        box-shadow: none !important;
        cursor: pointer !important;
    `;

    // Place minimize first and close second.
    controls.appendChild(minimizeButton);
    controls.appendChild(closeButton);
    container.appendChild(controls);

    // Create the restore button.
    const restoreButton = document.createElement('button');
    restoreButton.type = 'button';
    restoreButton.className = 'itp-popup-restore';
    restoreButton.textContent = 'Home Theatre Enquiry';
    restoreButton.setAttribute('aria-label', 'Restore home theatre enquiry');

    restoreButton.style.cssText = `
        display: none;
        position: fixed;
        right: 20px;
        bottom: 20px;
        padding: 12px 19px;
        border: 0;
        border-radius: 25px;
        background: #101b46;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        z-index: 999999;
    `;

    document.body.appendChild(restoreButton);

    // Minimize without triggering Popup Maker close.
    minimizeButton.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        container.style.display = 'none';

        const overlay = document.querySelector('#pum-2517-overlay');
        if (overlay) overlay.style.display = 'none';

        restoreButton.style.display = 'block';
    });

    // Restore the popup.
    restoreButton.addEventListener('click', function () {
        container.style.display = '';

        const overlay = document.querySelector('#pum-2517-overlay');
        if (overlay) overlay.style.display = '';

        restoreButton.style.display = 'none';
    });

});
</script><link rel="icon" href="https://icontechpro.in/wp-content/uploads/2024/06/feicon-150x150.png" sizes="32x32" />
