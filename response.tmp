<style>
/* ICON TECH PRO - Compact Premium Home Theatre Popup */

#pum-2517 {
    width: 520px !important;
    max-width: calc(100vw - 24px) !important;
    max-height: calc(100vh - 30px) !important;
    overflow-y: auto !important;
    border-radius: 12px !important;
    background: #ffffff !important;
    box-shadow: 0 12px 45px rgba(0,0,0,.22) !important;
}

#pum-2517 .pum-container {
    padding: 0 !important;
    border: 0 !important;
    background: #ffffff !important;
    border-radius: 12px !important;
}

#pum-2517 .pum-content {
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
}

#pum-2517 .itp-home-theatre,
#pum-2517 .itp-home-theatre * {
    box-sizing: border-box !important;
}

#pum-2517 .itp-home-theatre {
    width: 100%;
    margin: 0;
    color: #17213f;
    background: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
}

/* Clean white logo header */
#pum-2517 .itp-ht-header {
    padding: 13px 20px 10px !important;
    text-align: center;
    background: #ffffff !important;
    border-bottom: 2px solid #c6a15b;
}

#pum-2517 .itp-ht-logo {
    display: block;
    width: auto !important;
    max-width: 175px !important;
    max-height: 55px !important;
    height: auto !important;
    margin: 0 auto 5px !important;
    object-fit: contain;
}

#pum-2517 .itp-ht-logo-fallback {
    color: #101b46;
    font-size: 21px;
    font-weight: 800;
    margin-bottom: 5px;
}

#pum-2517 .itp-ht-logo-fallback span {
    color: #b28b42;
}

#pum-2517 .itp-ht-experience {
    margin: 0 !important;
    color: #9b7736 !important;
    font-size: 10px !important;
    font-weight: 700;
    letter-spacing: 1.5px;
}

/* Compact content */
#pum-2517 .itp-ht-body {
    padding: 15px 22px 18px !important;
    background: #ffffff;
}

#pum-2517 .itp-ht-title {
    margin: 0 0 7px !important;
    color: #101b46 !important;
    font-size: 23px !important;
    line-height: 1.2 !important;
    font-weight: 800 !important;
    text-align: left;
}

#pum-2517 .itp-ht-description {
    margin: 0 0 12px !important;
    color: #596174 !important;
    font-size: 13px !important;
    line-height: 1.45 !important;
}

#pum-2517 .itp-ht-form-heading {
    margin: 0 0 10px !important;
    padding-bottom: 7px !important;
    color: #101b46 !important;
    border-bottom: 1px solid #e9eaf0;
    font-size: 14px !important;
    font-weight: 700 !important;
}

/* WPForms compact spacing */
#pum-2517 .itp-home-theatre .wpforms-container {
    margin: 0 !important;
}

#pum-2517 .itp-home-theatre .wpforms-field {
    padding: 0 0 8px !important;
}

#pum-2517 .itp-home-theatre .wpforms-field-label {
    margin: 0 0 4px !important;
    color: #26314f !important;
    font-size: 12px !important;
    font-weight: 600 !important;
}

#pum-2517 .itp-home-theatre input[type="text"],
#pum-2517 .itp-home-theatre input[type="email"],
#pum-2517 .itp-home-theatre input[type="tel"],
#pum-2517 .itp-home-theatre input[type="number"],
#pum-2517 .itp-home-theatre select {
    width: 100% !important;
    min-height: 37px !important;
    height: 37px !important;
    padding: 7px 10px !important;
    border: 1px solid #d9deea !important;
    border-radius: 5px !important;
    background: #ffffff !important;
    color: #26314f !important;
    font-size: 13px !important;
    box-shadow: none !important;
}

#pum-2517 .itp-home-theatre textarea {
    width: 100% !important;
    min-height: 55px !important;
    padding: 7px 10px !important;
    border: 1px solid #d9deea !important;
    border-radius: 5px !important;
    background: #ffffff !important;
    color: #26314f !important;
    font-size: 13px !important;
}

#pum-2517 .itp-home-theatre input:focus,
#pum-2517 .itp-home-theatre textarea:focus,
#pum-2517 .itp-home-theatre select:focus {
    border-color: #b89652 !important;
    outline: 1px solid rgba(198,161,91,.2) !important;
}

#pum-2517 .itp-home-theatre .wpforms-submit-container {
    padding-top: 5px !important;
}

#pum-2517 .itp-home-theatre button.wpforms-submit {
    width: 100% !important;
    min-height: 42px !important;
    padding: 10px 15px !important;
    border: 0 !important;
    border-radius: 5px !important;
    background: #101b46 !important;
    color: #ffffff !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: .5px;
    text-transform: uppercase;
    cursor: pointer;
}

#pum-2517 .itp-home-theatre button.wpforms-submit:hover {
    background: #263765 !important;
}

#pum-2517 .itp-home-theatre .wpforms-error {
    font-size: 11px !important;
}

#pum-2517 .itp-home-theatre .wpforms-confirmation-container-full {
    padding: 12px !important;
